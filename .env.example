# Set a strong random shared secret when the origin is accessible through HTTPS.
HB_PROXY_SECRET=
HB_RETENTION_HOURS=12
HB_JOB_TIMEOUT=1200
HB_PROCESSOR_TARGET=full
HORIZONBRIDGE_ENABLE_NATIVE=1
HB_SCRATCH_SIZE=8g
HB_PROCESSOR_MEMORY=12g
HB_PROCESSOR_CPUS=4

# Optional administrator-controlled local model. The worker receives none of these values.
HB_AI_PROVIDER=ollama
HB_AI_URL=
HB_AI_MODEL=
HB_AI_TOKEN=
# Older Ollama-only variable names are accepted as fallbacks.
HB_OLLAMA_URL=
HB_OLLAMA_MODEL=
HB_OLLAMA_TOKEN=
